    "ssot:p0:check": "node scripts/sync_ssot_p0_endpoints.mjs --check",
    "audit:public-events": "node scripts/run-ts.cjs scripts/audit_public_events.ts",
    "orgs:convert-test-platform": "node scripts/run-ts.cjs scripts/convert_test_orgs_to_platform.ts",
    "v9:api-mapping": "node scripts/v9_api_frontend_mapping.mjs",
    "v9:inventory": "node scripts/v9_inventory.mjs",
    "v9:checklist": "node scripts/v9_generate_checklist.mjs",
    "auth:codemod:enforce-verified": "node scripts/codemods/enforce-verified-auth.mjs",
    "usernames:generate-reserved": "node scripts/run-ts.cjs scripts/generate-reserved-usernames.ts",
    "covers:build": "node scripts/generate_cover_library.js",
    "covers:fetch": "node scripts/fetch_openverse_covers.js",
    "covers:thumbs": "node -r ts-node/register scripts/covers/generate-thumbs.ts",
