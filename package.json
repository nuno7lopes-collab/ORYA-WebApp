    "mobile:cache:clean:hard": "node scripts/mobile-clean-cache.js --aggressive",
    "mobile:dev": "npm run mobile:cache:clean && cross-env EXPO_PUBLIC_API_BASE_URL=http://localhost:3000 npm --prefix apps/mobile run start -- -c --go --host lan",
    "mobile:dev:tunnel": "npm run mobile:cache:clean && npm --prefix apps/mobile run start -- -c --tunnel",
    "e2e:address:checklist": "node scripts/e2e/address_event_checklist.mjs",
    "e2e:ui:auth-bootstrap": "node scripts/e2e/ui_auth_bootstrap.mjs",
    "e2e:ui:seed-guard": "node scripts/e2e/ui_seed_guard.mjs",
    "test:ui:server:start": "node scripts/start-ui-e2e-server.mjs",
    "reset": "scripts/reset-dev-servers.sh",
    "reset:hard": "scripts/reset-dev-servers.sh --aggressive --full --no-exclude",
    "delete": "prisma db execute --file scripts/db/cleanup-app_v3.sql",
    "ops:healthcheck": "scripts/healthcheck.sh",
    "deploy:build-push": "scripts/build-and-push.sh",
    "deploy:cf": "scripts/deploy-cf.sh",
    "deploy:dev": "scripts/deploy-dev.sh",
    "secrets:upload": "scripts/upload-secrets.sh",
