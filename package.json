    "db:local:down": "docker compose -f infra/dev/docker-compose.db.yml down -v",
    "db:local:deploy": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:54322/orya_local DIRECT_URL=postgresql://postgres:postgres@localhost:54322/orya_local npm run db:deploy",
    "smoke:local:reservas:hybrid": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:54322/orya_local DIRECT_URL=postgresql://postgres:postgres@localhost:54322/orya_local npm run smoke:reservas:hybrid",
