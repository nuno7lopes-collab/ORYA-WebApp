    "start": "next start",
    "lint": "eslint",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:mobile": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc -p apps/mobile/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui:web": "node scripts/run-playwright-ui.mjs",
    "test:ui:a11y": "node scripts/run-playwright-ui.mjs --grep @a11y",
    "test:ui:responsive": "node scripts/run-playwright-ui.mjs --grep @responsive",
